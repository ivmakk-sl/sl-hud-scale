<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Hud\HudScaleLogic.cs" Link="HudScaleLogic.cs" />
    <Compile Include="..\..\src\Panel\PanelLogic.cs" Link="PanelLogic.cs" />
    <Compile Include="..\..\src\Panel\ConfigFileCheck.cs" Link="ConfigFileCheck.cs" />
    <Compile Include="..\..\src\Web\InstallCall.cs" Link="InstallCall.cs" />
    <Compile Include="..\..\src\SharpUi\SharpUiLogic.cs" Link="SharpUiLogic.cs" />
    <Compile Include="..\..\src\Shared\i18n\cs\*.cs" Link="Shared\i18n\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\src\i18n\*.json" LogicalName="HudScale.i18n.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

</Project>
